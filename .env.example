# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.
DATABASE_URL=sqlite:///./proofy.sqlite3
# 쉼표로 구분한 FE 주소
CORS_ORIGINS=http://localhost:5173
# scripted: Claude를 부르지 않는 가짜 분석 / claude: 실제 분석(T16부터)
AGENT_LLM=scripted
DEMO_MODE=true
# 서비스 전체 하루 AI 분석 한도(GET /health의 dailyUsage.limit)
DAILY_ANALYSIS_LIMIT=300
# 시간당 한도(429 RATE_LIMITED): 같은 IP의 사건 생성, 사건당 분석
RATE_LIMIT_CASES_PER_IP_HOUR=100
RATE_LIMIT_RUNS_PER_CASE_HOUR=5
# IP 해시 비밀값. 비우면 서버가 켜질 때 임의 값을 만든다
IP_HASH_SECRET=
# 만료 사건(생성 24시간 뒤) 정리 주기(초). 0이면 켜질 때 한 번만
CLEANUP_INTERVAL_SECONDS=600
# AGENT_LLM=claude일 때만 필요
ANTHROPIC_API_KEY=
# 글자 추출(AGENT_LLM=claude일 때). 비우면 PATH에서 찾는다
# 예) Windows: TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
PDFTOPPM_CMD=
OCR_LANG=kor+eng
